   "fieldtype": "Section Break",
   "label": "AI Engine (NeoNexus / OpenAI-compatible)"
  },
  {
   "fieldname": "ai_enabled",
   "fieldtype": "Check",
   "label": "Enable Neotec AI",
   "default": "0",
   "description": "When on, the Ask Neotec AI panel on the Reports screen sends live report figures to the endpoint below."
  },
  {
   "fieldname": "ai_endpoint",
   "fieldtype": "Data",
   "label": "AI Endpoint (OpenAI-compatible base URL)",
